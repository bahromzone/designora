# Copy this file to ".env" (cp env.example .env) and fill real values.
# NEVER commit the real .env file.

# ===== DATABASE =====
# Faqat PostgreSQL ishlatiladi. Drayver: psycopg2 (requirements.txt: psycopg2-binary).
# Local dev: postgresql+psycopg2://postgres:password@localhost:5432/designora
# Docker compose: postgresql+psycopg2://designora:designora@db:5432/designora
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/designora

# ===== CORE =====
# Generate strong random values:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-strong-random
ENVIRONMENT=development

# ===== SESSION =====
SESSION_SECRET_KEY=change-me-strong-random

# ===== JWT =====
JWT_SECRET_KEY=change-me-strong-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== GOOGLE OAUTH (optional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== EMAIL (SMTP) =====
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your@email.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ===== reCAPTCHA =====
RECAPTCHA_SECRET_KEY=your-recaptcha-secret

# ===== CORS (comma-separated) =====
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ===== MEDIA =====
media_signing_key=change-me-strong-random
MEDIA_CDN_BASE_URL=
VIDEO_STORAGE_BUCKET=designora-videos
VIDEO_STORAGE_REGION=auto
VIDEO_STORAGE_ENDPOINT=
VIDEO_STORAGE_ACCESS_KEY=
VIDEO_STORAGE_SECRET_KEY=
VIDEO_STORAGE_PUBLIC_BASE_URL=
VIDEO_UPLOAD_PART_SIZE_MB=16
VIDEO_UPLOAD_MAX_GB=3
VIDEO_UPLOAD_URL_TTL_SECONDS=900

# ===== DRM PILOT =====
# Keep disabled until PallyCon packaging and license endpoints are configured.
DRM_ENABLED=false
DRM_PROVIDER=pallycon
DRM_MANIFEST_BASE_URL=
DRM_WIDEVINE_LICENSE_URL=
DRM_FAIRPLAY_LICENSE_URL=
DRM_FAIRPLAY_CERTIFICATE_URL=
DRM_PLAYREADY_LICENSE_URL=

# ===== PAYMENTS =====
PAYME_KEY=
PAYME_MERCHANT_ID=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
